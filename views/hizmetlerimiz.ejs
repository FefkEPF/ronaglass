                </div>
                <div class="gallery-item">
                    <img src="images/kabin3.png" alt="Traktör Camı Rona Auto Glass" loading="lazy">
                    <div class="gallery-overlay"><span class="gallery-title">Kabin Yan & Arka Camlar</span></div>
                </div>
            </div>
        </div>
    </section>

