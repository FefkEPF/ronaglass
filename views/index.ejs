<body style="background:#050505;margin:0;">
    <!-- INLINE CRITICAL CSS (prevents white flash) -->
    <style>
        body {
            background: #050505 !important;
        }

        .loader {
            position: fixed;
            inset: 0;
            background: #050505;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 100000;
        }

        .loader-inner {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 28px;
            padding: 24px;
        }

        .loader-logo {
            max-height: 64px;
            width: auto;
            filter: drop-shadow(0 0 22px rgba(212, 175, 55, 0.45));
        }

        .loader-bar {
            width: 90%;
            max-width: 240px;
            height: 3px;
            background: rgba(255, 255, 255, 0.07);
            overflow: hidden;
            border-radius: 3px;
        }

        .loader-progress {
            height: 100%;
            width: 0;
            background: linear-gradient(90deg, #aa8c2c, #d4af37, #f3e5ab);
        }

        .loader-text {
            color: #d4af37;
            font-size: 11px;
            letter-spacing: 5px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 14px 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 10000;
            background: rgba(10, 10, 15, 0.9);
        }

        .logo-brand {
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .logo-img {
            height: 48px;
            width: auto;
        }

        .logo-main {
            font-size: 20px;
            font-weight: 600;
            letter-spacing: 3px;
            color: #fff;
            line-height: 1;
        }

        .logo-sub {
            font-size: 8px;
            letter-spacing: 3px;
            color: #d4af37;
            font-weight: 700;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 28px;
        }

        .nav-link {
            color: #a1a1a6;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-phone-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 20px;
            border: 1px solid rgba(212, 175, 55, 0.35);
            border-radius: 40px;
            color: #d4af37;
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
        }

        .mobile-header-ctas {
            display: none;
            align-items: center;
            gap: 8px;
        }

        .nav-cta-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            height: 36px;
            padding: 0 12px;
            border-radius: 18px;
            font-size: 11.5px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
        }

        .nav-cta-btn.whatsapp {
            background: #25D366;
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        .nav-cta-btn.whatsapp:hover, .nav-cta-btn.whatsapp:active {
            background: #20bd5a;
            transform: translateY(-1px);
        }

        .nav-cta-btn.phone {
            background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%);
            color: #07070a;
            border: 1px solid rgba(255, 215, 0, 0.4);
        }

        .nav-cta-btn.phone:hover, .nav-cta-btn.phone:active {
            background: linear-gradient(135deg, #e5be3f 0%, #b88714 100%);
            transform: translateY(-1px);
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            /* minimum 44px dokunma hedefi — style.css'teki kuralla aynı */
            padding: 10px;
            min-width: 44px;
            min-height: 44px;
            align-items: center;
            justify-content: center;
        }

        .hamburger span {
            width: 24px;
            height: 2px;
            background: #fff;
        }

        @media(max-width:1024px) {
            .nav-links {
                display: none;
            }

            .hamburger {
                display: flex;
            }

            .navbar {
                padding: 14px 20px;
            }
        }

        @media(max-width:768px) {
            .desktop-only-btn {
                display: none !important;
            }

            .mobile-header-ctas.mobile-only-btn {
                display: flex !important;
            }
        }

        @media(max-width:480px) {
            .navbar {
                padding: 12px 14px;
            }

            .nav-cta-btn {
                height: 32px;
                padding: 0 10px;
                font-size: 11px;
            }
        }
    </style>

