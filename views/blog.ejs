<%- include('partials/head', {"title": "Rona Auto Glass | Blog & Oto Cam Rehberi", "description": "Rona Auto Glass Blog - Oto cam bakımı, 15 dakikada taş tamiri püf noktaları, kaskolu ücretsiz cam değişimi ve sürüş güvenliği rehberi.", "keywords": "oto cam blog, taş tamiri nasıl yapılır, kaskodan cam değişimi detayları, rona auto glass rehber", "canonical": "https://ronaglass.com.tr/blog.html", "ogTitle": "Rona Auto Glass | Blog & Oto Cam Rehberi", "ogDescription": "Sürüş güvenliği, cam bakımı, taş tamiri ve kasko süreçleri hakkında faydalı bilgiler ve uzman tavsiyeleri."}) %>
</head>
<body>
    <!-- LOADER -->
    <div class="loader" id="loader">
        <div class="loader-inner">
            <img src="images/logo.png" alt="Rona Auto Glass" class="loader-logo" width="120" height="120">
            <div class="loader-bar"><div class="loader-progress" id="loader-progress"></div></div>
            <p class="loader-text">Blog & Rehber Yükleniyor</p>
        </div>
    </div>

    <!-- NAVBAR -->
    <%- include('partials/navbar', { active: 'blog' }) %>

    <!-- PAGE HERO -->
    <header class="page-hero">
        <div class="container">
            <p class="section-tag"><%= settings.blog_hero_tag || "BİLGİ & UZMANLIK" %></p>
            <h1 class="page-hero-title"><%= settings.blog_hero_title || "Oto Cam Blog & Rehber" %></h1>
            <p class="page-hero-sub"><%= settings.blog_hero_sub || "Cam bakımı, kasko hakları, 15 dakikada taş tamiri tekniği ve güvenli sürüş için uzman tavsiyeleri." %></p>
        </div>
    </header>

    <!-- ARTICLES GRID -->
    <section class="articles-section">
        <div class="container">
            <div class="blog-grid">
                <article class="blog-card">
                    <div class="blog-image">
                        <img loading="lazy" src="images/IMG_8611.jpeg" alt="15 Dakikada Çatlak Cam Tamiri">
                        <div class="blog-image-placeholder"></div>
                        <span class="blog-tag">CAM TAMİRİ</span>
                    </div>
                    <div class="blog-body">
                        <h3><span class="desktop-text">15 Dakikada Çatlak Cam Tamiri Nasıl Yapılır?</span><span class="mobile-text">15 Dakikada Cam Tamiri</span></h3>
                        <p>Ön camınızdaki taş vuruklarını değiştirmeden 15 dakikada özel reçine vakumlama teknolojimiz ile orijinal yapısını bozmadan ilk günkü sağlamlığına kavuşturuyoruz.</p>
                        <a href="bize-ulasin.html" class="blog-read-more">Randevu Al →</a>
                    </div>
                </article>

                <article class="blog-card">
                    <div class="blog-image">
                        <img loading="lazy" src="images/IMG_8590.jpeg" alt="Kaskolu Cam Değişimi Rehberi">
                        <div class="blog-image-placeholder"></div>
                        <span class="blog-tag">KASKO REHBERİ</span>
                    </div>
                    <div class="blog-body">
                        <h3><span class="desktop-text">Kaskonuz Bozulmadan Ücretsiz Cam Değişimi Hakları</span><span class="mobile-text">Kasko Cam Değişimi</span></h3>
                        <p>Araç kaskonuz kapsamındaki yılda 1 defa ücretsiz ve hasarsızlık indirimi bozulmadan cam değişim hakkınız hakkında bilmeniz gereken tüm detaylar.</p>
                        <a href="bize-ulasin.html" class="blog-read-more">Kasko İncele →</a>
                    </div>
                </article>

                <article class="blog-card">
                    <div class="blog-image">
                        <img loading="lazy" src="images/IMG_8601.jpeg" alt="Silecek Bakımı Ve Ön Cam Koruma">
                        <div class="blog-image-placeholder"></div>
                        <span class="blog-tag">BAKIM İPUÇLARI</span>
                    </div>
                    <div class="blog-body">
                        <h3><span class="desktop-text">Silecek Bakımı Ve Ön Cam Çizilmelerini Önleme Yolları</span><span class="mobile-text">Cam Bakımı</span></h3>
                        <p>Silecek süpürgelerinin zamanında değiştirilmesi ön cam çizilmelerini engeller. Şeffaf görüş ve uzun cam ömrü için bakım tavsiyeleri.</p>
                        <a href="bize-ulasin.html" class="blog-read-more">Detaylı Oku →</a>
                    </div>
                </article>

                <article class="blog-card">
                    <div class="blog-image">
                        <img loading="lazy" src="images/IMG_8634.png" alt="7/24 Mobil Servis Aracı">
                        <div class="blog-image-placeholder"></div>
                        <span class="blog-tag">MOBİL SERVİS</span>
                    </div>
                    <div class="blog-body">
                        <h3><span class="desktop-text">Yerinde Mobil Servis: Evinizde veya İş Yerinizde Cam Montajı</span><span class="mobile-text">Mobil Servis</span></h3>
                        <p>Zaman kaybetmeden bulunduğunuz konuma mobil servis aracımızla gelip aynı gün içerisinde cam değişimi gerçekleştiriyoruz.</p>
                        <a href="bize-ulasin.html" class="blog-read-more">Mobil Servis Çağır →</a>
                    </div>
                </article>
            </div>
        </div>
    </section>

        <!-- FLOATING CTA -->
    <%- include('partials/floating-cta') %>

    <!-- FOOTER -->
    <%- include('partials/footer') %>
    <script src="script.js?v=18"></script>

    <!-- APPOINTMENT MODAL -->
    <div class="modal-overlay" id="appointment-modal">
        <div class="modal">
            <div class="modal-header">
                <h2>Hızlı Teklif / Randevu</h2>
                <button class="modal-close" id="modal-close" aria-label="Kapat">&times;</button>
            </div>
            <form class="modal-form" id="modal-appointment-form">
                <div class="form-group">
                    <label for="modal-name">Ad Soyad</label>
                    <input type="text" id="modal-name" placeholder="Adınız Soyadınız" required>
                </div>
                <div class="form-group">
                    <label for="modal-phone">Telefon</label>
                    <input type="tel" id="modal-phone" placeholder="05XX XXX XX XX" required>
                </div>
                <div class="form-group">
                    <label for="modal-vehicle">Araç Marka / Model</label>
                    <input type="text" id="modal-vehicle" placeholder="Örn: 2020 Volkswagen Passat">
                </div>
                <div class="form-group">
                    <label for="modal-service">Hizmet Türü</label>
                    <select id="modal-service">
                        <option value="">Seçiniz</option>
                        <option value="kasko">Kaskolu Cam Değişimi (Ücretsiz)</option>
                        <option value="tamir">15 Dk Taş Tamiri / Çatlak Onarımı</option>
                        <option value="binek">Binek Araç Cam Değişimi</option>
                        <option value="mobil">7/24 Mobil Servis Talebi</option>
                        <option value="ticari">Ticari / Tır / Otobüs Camı</option>
                        <option value="traktor">Traktör & Kabin Camı</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Kasko Durumu</label>
                    <div class="radio-group">
                        <div class="radio-option">
                            <input type="radio" id="kasko-var" name="kasko" value="var" checked>
                            <label for="kasko-var">Kaskom Var</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="kasko-yok" name="kasko" value="yok">
                            <label for="kasko-yok">Kaskom Yok</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn-primary modal-submit">Talebi Gönder →</button>
            </form>
        </div>
    </div>
</body>
</html>





