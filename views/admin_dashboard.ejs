<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Rona Auto Glass</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #050505; color: #fff; }
        .navbar-custom { background-color: #111; border-bottom: 1px solid #333; }
        .card { background-color: #111; border: 1px solid #333; }
        .form-control { background-color: #222; color: #fff; border: 1px solid #444; }
        .form-control:focus { background-color: #222; color: #fff; border-color: #d4af37; box-shadow: none; }
        .btn-primary { background-color: #d4af37; border: none; color: #000; }
        .btn-primary:hover { background-color: #aa8c2c; }
        .text-gold { color: #d4af37; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand text-gold fw-bold" href="/admin">
                <img src="/images/logo.png" alt="Logo" height="30" class="d-inline-block align-text-top me-2">
                Rona Admin
            </a>
            <div class="d-flex">
                <a href="/" class="btn btn-outline-light me-2" target="_blank">Siteyi Görüntüle</a>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <h2 class="mb-4">Gelen Talepler</h2>
        <div class="card p-4 mb-5">
            <% if (!leads || leads.length === 0) { %>
                <p class="text-muted mb-0">Henüz form talebi yok. (Veritabanı bağlı değilse talepler WhatsApp'a yönlenir.)</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-dark table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Tarih</th><th>Ad Soyad</th><th>Telefon</th><th>Araç</th>
                                <th>Hizmet</th><th>Kasko</th><th>Mesaj</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% leads.forEach(l => { %>
                                <tr>
                                    <td class="text-nowrap"><%= new Date(l.created_at).toLocaleString('tr-TR') %></td>
                                    <td><%= l.name %></td>
                                    <td><a class="text-gold" href="tel:<%= l.phone %>"><%= l.phone %></a></td>
                                    <td><%= l.vehicle || '-' %></td>
                                    <td><%= l.service || '-' %></td>
                                    <td><%= l.kasko || '-' %></td>
                                    <td style="max-width:280px"><%= l.message || '-' %></td>
                                    <td>
                                        <form action="/admin/leads/delete" method="POST" onsubmit="return confirm('Talep silinsin mi?');">
                                            <input type="hidden" name="id" value="<%= l.id %>">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>

        <h2 class="mb-4">Site Ayarları</h2>
        
        <div class="card p-4 mb-4">
            <h4>Genel Ayarlar</h4>
            <p class="text-muted">Buradan sitedeki metinleri güncelleyebilirsiniz (Örn: Hero başlığı).</p>
            
            <% Object.keys(settings).forEach(key => { %>
                <form action="/admin/settings" method="POST" class="mb-3 border-bottom border-secondary pb-3">
                    <input type="hidden" name="key" value="<%= key %>">
                    <label class="form-label text-light fw-bold"><%= key.toUpperCase() %></label>
                    <div class="input-group">
                        <textarea class="form-control" name="value" rows="2"><%= settings[key] %></textarea>
                        <button class="btn btn-primary" type="submit">Güncelle</button>
                    </div>
                </form>
                <form action="/admin/settings/delete" method="POST" class="mt-2 text-end" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                     <input type="hidden" name="key" value="<%= key %>">
                     <button class="btn btn-sm btn-outline-danger" type="submit">Sil</button>
                </form>
            <% }) %>

            <% if (Object.keys(settings).length === 0) { %>
                <p class="text-warning">Henüz ayar bulunmuyor. Yeni bir ayar ekleyebilirsiniz.</p>
            <% } %>

            <hr class="border-secondary my-4">
            <h4 class="text-gold">Yeni Ayar Ekle</h4>
            <form action="/admin/settings" method="POST" class="mt-3">
                <div class="row">
                    <div class="col-md-4">
                        <input type="text" class="form-control" name="key" placeholder="Ayar Anahtarı (örn: baslik_1)" required>
                    </div>
                    <div class="col-md-6">
                        <textarea class="form-control" name="value" rows="1" placeholder="Ayar Değeri" required></textarea>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" type="submit">Ekle</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="card p-4">
            <h4>Medya & Logolar</h4>
            <p class="text-muted">Logo veya ikon güncellemeleri için dosyaları /public/images klasörüne yükleyebilir veya FTP/CPanel üzerinden değiştirebilirsiniz. Optimizasyon komut dosyaları projede eklidir.</p>
        </div>
    </div>
</body>
</html>
