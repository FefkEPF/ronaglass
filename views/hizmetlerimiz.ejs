<%- include('partials/head', {"title": "Rona Auto Glass | Hizmetlerimiz & Uygulamalar", "description": "Rona Auto Glass Hizmetlerimiz - Kaskolu araçlara ücretsiz cam değişimi, 15 dakikada taş tamiri, mobil montaj, traktör kabin camı ve ticari araç oto cam çözümleri.", "keywords": "kaskolu cam değişimi, 15 dakika cam tamiri, mobil oto cam montajı, traktör kabin camı ankara, etimesgut şaşmaz oto cam hizmetleri", "canonical": "https://ronaglass.com.tr/hizmetlerimiz.html", "ogTitle": "Rona Auto Glass | Hizmetlerimiz & Uygulamalar", "ogDescription": "Tüm marka ve modellere uygun binek, ticari, tır ve iş makinesi oto cam değişimi ve tamir hizmetleri."}) %>
</head>

<body>
    <!-- LOADER -->
    <div class="loader" id="loader">
        <div class="loader-inner">
            <img src="images/logo.png" alt="Rona Auto Glass" class="loader-logo" width="120" height="120">
            <div class="loader-bar">
                <div class="loader-progress" id="loader-progress"></div>
            </div>
            <p class="loader-text">Camda Şeffaf Çözüm Yükleniyor</p>
        </div>
    </div>

    <!-- NAVBAR -->
    <%- include('partials/navbar', { active: 'hizmetlerimiz' }) %>

    <!-- PAGE HERO -->
