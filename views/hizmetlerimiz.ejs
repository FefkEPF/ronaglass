        <div class="container">
            <p class="section-tag"><%= settings.hizmetlerimiz_hero_tag || "HİZMET KATALOĞUMUZ" %></p>
            <h1 class="page-hero-title"><%= settings.hizmetlerimiz_hero_title || "Oto Cam Servis Hizmetlerimiz" %></h1>
            <p class="page-hero-sub"><%= settings.hizmetlerimiz_hero_sub || "Binek araçlardan iş makinelerine, kaskolu ücretsiz değişimden 15 dakikada taş tamirine kadar tüm çözümler." %></p>
        </div>
    </header>

    <!-- SERVICES CARDS SECTION -->
