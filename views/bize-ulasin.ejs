<%- include('partials/head', {"title": "Rona Auto Glass | İletişim & Randevu", "description": "Rona Auto Glass İletişim - Ankara Etimesgut Şaşmaz Oto Sanayi servis noktamızın adresi, telefon numaraları, harita konumu ve hızlı fiyat teklif formu.", "keywords": "rona auto glass iletişim, etimesgut şaşmaz oto cam adresi, rona oto cam telefon, ankara oto cam randevu", "canonical": "https://ronaglass.com.tr/bize-ulasin.html", "ogTitle": "Rona Auto Glass | İletişim & Randevu", "ogDescription": "Ankara Şaşmaz Oto Sanayi servis noktamıza gelin ya da 7/24 mobil montaj ekibimizi çağırın."}) %>
</head>
<body>
    <!-- LOADER -->
    <div class="loader" id="loader">
        <div class="loader-inner">
            <img src="images/logo.png" alt="Rona Auto Glass" class="loader-logo" width="120" height="120">
            <div class="loader-bar"><div class="loader-progress" id="loader-progress"></div></div>
            <p class="loader-text">İletişim Sayfası Yükleniyor</p>
        </div>
    </div>

    <!-- NAVBAR -->
    <%- include('partials/navbar', { active: 'bize-ulasin' }) %>

    <!-- PAGE HERO -->
    <header class="page-hero">
        <div class="container">
            <p class="section-tag">İLETİŞİM & RANDEVU</p>
            <h1 class="page-hero-title">Bizimle İletişime Geçin</h1>
            <p class="page-hero-sub">Ankara Şaşmaz servis noktamıza gelin ya da mobil montaj ekibimizi bulunduğunuz adrese çağırın.</p>
        </div>
    </header>

    <!-- CONTACT SECTION -->
    <section class="contact-section">
        <div class="container">
            <div class="contact-grid">
                <form class="contact-form" id="contact-form">
                    <h3 class="form-title">Hızlı Fiyat & Randevu Talebi</h3>
                    <div class="form-group">
                        <input type="text" placeholder="Adınız Soyadınız" required aria-label="Ad Soyad">
                    </div>
                    <div class="form-group">
                        <input type="tel" placeholder="Telefon Numaranız (05XX...)" required aria-label="Telefon">
                    </div>
                    <div class="form-group">
                        <select class="form-select" aria-label="Hizmet Türü">
                            <option value="kasko">Kaskolu Cam Değişimi (Ücretsiz)</option>
                            <option value="tamir">15 Dk Taş Tamiri / Çatlak Onarımı</option>
                            <option value="binek">Binek Araç Cam Değişimi</option>
                            <option value="mobil">7/24 Mobil Servis Talebi</option>
                            <option value="ticari">Ticari / Tır / Otobüs Camı</option>
                            <option value="traktor">Traktör & Kabin Camı</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <input type="text" placeholder="Araç Marka & Model (Örn: 2020 VW Passat)" required aria-label="Araç Bilgisi">
                    </div>
                    <div class="form-group">
                        <textarea rows="4" placeholder="Notunuz veya Cam Hasar Bilgisi..." aria-label="Mesaj"></textarea>
                    </div>
                    <button type="submit" class="btn-primary btn-full">Talebi Gönder →</button>
                </form>

                <div class="contact-info-col">
                    <div class="contact-card">
                        <div class="card-icon"><svg class="icon-svg-gold" viewBox="0 0 24 24" width="24" height="24" fill="var(--gold)"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg></div>
                        <div>
                            <h4>Servis Adresimiz</h4>
                            <p>2474 Cad 4/1 Şaşmaz, Etimesgut / Ankara</p>
                            <a href="https://maps.google.com/?q=2474+Cad+4/1+Şaşmaz+Etimesgut+Ankara" target="_blank" class="card-link">Haritada Yol Tarifi Al →</a>
                        </div>
                    </div>

                    <div class="contact-card">
                        <div class="card-icon"><svg class="icon-svg-gold" viewBox="0 0 24 24" width="24" height="24" fill="var(--gold)"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>
                        <div>
                            <h4>Müşteri Hizmetleri & Mobil Servis</h4>
                            <p>Telefon: <a href="tel:<%= settings.phone_number ? settings.phone_number.replace(/\s+/g, '') : ('+' + (settings.whatsapp_number || '905346943789')) %>" class="footer-phone-link"><%= settings.phone_number || '0534 694 37 89' %></a></p>
                            <p>WhatsApp: <a href="https://wa.me/<%= settings.whatsapp_number || '905346943789' %>" target="_blank" class="text-gold">7/24 Mesaj Gönderin</a></p>
                        </div>
                    </div>

                    <div class="contact-card">
                        <div class="card-icon"><svg class="icon-svg-gold" viewBox="0 0 24 24" width="24" height="24" fill="var(--gold)"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg></div>
                        <div>
                            <h4>Çalışma Saatlerimiz</h4>
                            <p>Pazartesi - Cumartesi: 08:30 - 19:00</p>
                            <p>Pazar: Mobil Servis (Randevulu)</p>
                        </div>
                    </div>

                    <div class="map-container">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3058.461073860431!2d32.7079112!3d39.9390286!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14d347c6178e2d43%3A0xa1969a53be4b533b!2s%C5%9Ea%C5%9Fmaz%2C%20Etimesgut%2FAnkara!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str" width="100%" height="220" title="Rona Auto Glass Konum" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

        <!-- FLOATING CTA -->
    <div class="floating-cta">
        <a href="https://wa.me/<%= settings.whatsapp_number || '905346943789' %>?text=Merhaba,%20oto%20cam%20fiyat%C4%B1%20almak%20istiyorum."
            target="_blank" class="cta-btn whatsapp" aria-label="WhatsApp">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path
                    d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
            </svg>
            <span>WhatsApp</span>
        </a>
        <a href="tel:<%= (settings.phone_number || '0534 694 37 89').replace(/\s+/g, '') %>" class="cta-btn phone" aria-label="Telefon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>Bizi Arayın</span>
        </a>
    </div>

    <!-- FOOTER -->
    <%- include('partials/footer') %>

    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
    <script src="script.js?v=15"></script>

    <!-- APPOINTMENT MODAL -->
    <div class="modal-overlay" id="appointment-modal">
        <div class="modal">
            <div class="modal-header">
                <h2>Hızlı Teklif / Randevu</h2>
                <button class="modal-close" id="modal-close" aria-label="Kapat">&times;</button>
            </div>
            <form class="modal-form" id="modal-appointment-form">
                <div class="form-group">
                    <label for="modal-name">Ad Soyad</label>
                    <input type="text" id="modal-name" placeholder="Adınız Soyadınız" required>
                </div>
                <div class="form-group">
                    <label for="modal-phone">Telefon</label>
                    <input type="tel" id="modal-phone" placeholder="05XX XXX XX XX" required>
                </div>
                <div class="form-group">
                    <label for="modal-vehicle">Araç Marka / Model</label>
                    <input type="text" id="modal-vehicle" placeholder="Örn: 2020 Volkswagen Passat">
                </div>
                <div class="form-group">
                    <label for="modal-service">Hizmet Türü</label>
                    <select id="modal-service">
                        <option value="">Seçiniz</option>
                        <option value="kasko">Kaskolu Cam Değişimi (Ücretsiz)</option>
                        <option value="tamir">15 Dk Taş Tamiri / Çatlak Onarımı</option>
                        <option value="binek">Binek Araç Cam Değişimi</option>
                        <option value="mobil">7/24 Mobil Servis Talebi</option>
                        <option value="ticari">Ticari / Tır / Otobüs Camı</option>
                        <option value="traktor">Traktör & Kabin Camı</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Kasko Durumu</label>
                    <div class="radio-group">
                        <div class="radio-option">
                            <input type="radio" id="kasko-var" name="kasko" value="var" checked>
                            <label for="kasko-var">Kaskom Var</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="kasko-yok" name="kasko" value="yok">
                            <label for="kasko-yok">Kaskom Yok</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn-primary modal-submit">Talebi Gönder →</button>
            </form>
        </div>
    </div>
</body>
</html>





