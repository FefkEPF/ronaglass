<%- include('partials/head', {"title": "Rona Auto Glass | Hakkımızda - Kurumsal Tarihçe", "description": "Rona Auto Glass hakkında - Ankara Etimesgut Şaşmaz'da yılların tecrübesi ile orijinal standartlarda oto cam değişimi ve tamir hizmetleri veren kurumsal cam servisi.", "keywords": "rona auto glass hakkında, etimesgut oto cam firmaları, şaşmaz kurumsal cam servisi, rona oto cam ankara", "canonical": "https://ronaglass.com.tr/hakkimizda.html", "ogTitle": "Rona Auto Glass | Hakkımızda - Kurumsal Tarihçe", "ogDescription": "Yıllara dayanan tecrübemiz ve uzman ekibimizle Ankara'da güvenli sürüş için şeffaf oto cam çözümleri."}) %>
</head>

<body>
    <!-- LOADER -->
    <div class="loader" id="loader">
        <div class="loader-inner">
            <img src="images/logo.png" alt="Rona Auto Glass" class="loader-logo" width="120" height="120">
            <div class="loader-bar">
                <div class="loader-progress" id="loader-progress"></div>
            </div>
            <p class="loader-text">Camda Şeffaf Çözüm Yükleniyor</p>
        </div>
    </div>

    <!-- NAVBAR -->
    <%- include('partials/navbar', { active: 'hakkimizda' }) %>

    <!-- PAGE HERO -->
    <header class="page-hero">
        <div class="container">
            <p class="section-tag"><%= settings.hakkimizda_hero_tag || "KURUMSAL" %></p>
            <h1 class="page-hero-title"><%= settings.hakkimizda_hero_title || "Rona Auto Glass Hakkında" %></h1>
            <p class="page-hero-sub"><%= settings.hakkimizda_hero_sub || "Yılların birikimi, uzman teknisyen kadrosu ve orijinal kalite odaklı hizmet anlayışımız ile Ankara'da lider oto cam servisi." %></p>
        </div>
    </header>

    <!-- ABOUT STORY SECTION -->
    <section class="story-section">
        <div class="container">
            <div class="story-container">
                <div class="story-image">
                    <img loading="lazy" src="images/IMG_8594.jpeg" alt="Rona Auto Glass Atölyesi">
                    <div class="story-image-badge">
                        <span class="badge-num">15+</span>
                        <span class="badge-txt">Yıllık Tecrübe &<br>Uzmanlık</span>
                    </div>
                </div>
                <div class="story-content">
                    <p class="section-tag">HİKAYEMİZ & MİSYONUMUZ</p>
                    <h2 class="section-title text-left"><span class="desktop-text">Cam Sektöründe Güven ve Kalitenin
                            Adresi</span><span class="mobile-text">Güven ve Kalite</span></h2>
                    <div class="story-text">
                        <p>Rona Auto Glass olarak Ankara Etimesgut Şaşmaz Sanayi Sitesi'nde faaliyet göstermekteyiz.
                            Sektördeki yenilikleri yakından takip eden uzman ekibimizle otomobil, hafif ticari, otobüs,
                            tır ve traktör kabin camları olmak üzere geniş bir segmentte oto cam hizmeti sunmaktayız.
                        </p>
                        <br>
                        <p>Temel hedefimiz, kaskolu araç sahiplerinin hasarsızlık indirimlerini bozmadan orijinal
                            standartta cam değişimi yapmalarını sağlamaktır. Bunun yanı sıra 15 dakikada garantili taş
                            tamiri reçine uygulamalarımız ve 7/24 mobil servis imkanımızla müşterilerimizin zamanına
                            değer veriyoruz.</p>
                    </div>

                    <div class="story-stats">
                        <div class="stat-item">
                            <span class="stat-num">10.000+</span>
                            <span class="stat-lbl">Tamamlanan Montaj</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-num">25+</span>
                            <span class="stat-lbl">Anlaşmalı Sigorta</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-num">%100</span>
                            <span class="stat-lbl">Müşteri Memnuniyeti</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- REFERENCES SECTION -->
    <section class="references-section">
        <div class="container">
            <div class="section-header">
                <p class="section-tag">KURUMSAL GÜVEN & İŞ ORTAKLIKLARI</p>
                <h2 class="section-title"><span class="desktop-text">Resmi Sözleşmeli Referanslarımız</span><span
                        class="mobile-text">Referanslarımız</span></h2>
                <p class="section-desc">Sözleşmeli ve protokollü olarak cam değişim ve bakım hizmeti verdiğimiz Türkiye'nin önde gelen kurumsal firmaları.</p>
            </div>

            <div class="ref-grid">
                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_turoto.jpg" alt="Tur Oto" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">TUR OTO</div>
                    </div>
                    <h3 class="ref-title">Tur Oto</h3>
                    <span class="ref-badge">Ford Yetkili Servisi & Filo</span>
                </div>

                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_otokoc.jpg" alt="Otokoç Birmot Otomotiv" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">OTOKOÇ</div>
                    </div>
                    <h3 class="ref-title">Otokoç Birmot</h3>
                    <span class="ref-badge">Yetkili Servis Anlaşması</span>
                </div>

                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_tanoto.jpg" alt="Tan Oto" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">TAN OTO</div>
                    </div>
                    <h3 class="ref-title">Tan Oto</h3>
                    <span class="ref-badge">Ford Yetkili Servisi & Filo</span>
                </div>

                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_intercity.jpg" alt="Intercity" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">INTERCITY</div>
                    </div>
                    <h3 class="ref-title">Intercity</h3>
                    <span class="ref-badge">Filo Kiralama Operasyonu</span>
                </div>

                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_alj.jpg" alt="ALJ Otomotiv" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">ALJ OTOMOTİV</div>
                    </div>
                    <h3 class="ref-title">ALJ Otomotiv</h3>
                    <span class="ref-badge">Toyota Yetkili Servis Anlaşması</span>
                </div>

                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_yok.jpg" alt="Yükseköğretim Kurulu (YÖK)" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">YÖK</div>
                    </div>
                    <h3 class="ref-title">YÖK (Yükseköğretim Kurulu)</h3>
                    <span class="ref-badge">Kurumsal Hizmet Protokolü</span>
                </div>

                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_osym.jpg" alt="ÖSYM Başkanlığı" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">ÖSYM</div>
                    </div>
                    <h3 class="ref-title">ÖSYM Başkanlığı</h3>
                    <span class="ref-badge">Kurumsal Hizmet Protokolü</span>
                </div>

                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_anayasa.jpg" alt="Anayasa Mahkemesi" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">ANAYASA MAHKEMESİ</div>
                    </div>
                    <h3 class="ref-title">Anayasa Mahkemesi</h3>
                    <span class="ref-badge">Kurumsal Hizmet Protokolü</span>
                </div>

                <div class="ref-card">
                    <div class="ref-img-box">
                        <img loading="lazy" src="images/ref_yargitay.jpg" alt="Yargıtay Başkanlığı" class="ref-img"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="ref-img-placeholder" style="display:none;" aria-hidden="true">YARGITAY</div>
                    </div>
                    <h3 class="ref-title">Yargıtay Başkanlığı</h3>
                    <span class="ref-badge">Kurumsal Hizmet Protokolü</span>
                </div>
            </div>
        </div>
    </section>

        <!-- FLOATING CTA -->
    <%- include('partials/floating-cta') %>

    <!-- FOOTER -->
    <%- include('partials/footer') %>
    <script src="script.js?v=17"></script>

    <!-- APPOINTMENT MODAL -->
    <div class="modal-overlay" id="appointment-modal">
        <div class="modal">
            <div class="modal-header">
                <h2>Hızlı Teklif / Randevu</h2>
                <button class="modal-close" id="modal-close" aria-label="Kapat">&times;</button>
            </div>
            <form class="modal-form" id="modal-appointment-form">
                <div class="form-group">
                    <label for="modal-name">Ad Soyad</label>
                    <input type="text" id="modal-name" placeholder="Adınız Soyadınız" required>
                </div>
                <div class="form-group">
                    <label for="modal-phone">Telefon</label>
                    <input type="tel" id="modal-phone" placeholder="05XX XXX XX XX" required>
                </div>
                <div class="form-group">
                    <label for="modal-vehicle">Araç Marka / Model</label>
                    <input type="text" id="modal-vehicle" placeholder="Örn: 2020 Volkswagen Passat">
                </div>
                <div class="form-group">
                    <label for="modal-service">Hizmet Türü</label>
                    <select id="modal-service">
                        <option value="">Seçiniz</option>
                        <option value="kasko">Kaskolu Cam Değişimi (Ücretsiz)</option>
                        <option value="tamir">15 Dk Taş Tamiri / Çatlak Onarımı</option>
                        <option value="binek">Binek Araç Cam Değişimi</option>
                        <option value="mobil">7/24 Mobil Servis Talebi</option>
                        <option value="ticari">Ticari / Tır / Otobüs Camı</option>
                        <option value="traktor">Traktör & Kabin Camı</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Kasko Durumu</label>
                    <div class="radio-group">
                        <div class="radio-option">
                            <input type="radio" id="kasko-var" name="kasko" value="var" checked>
                            <label for="kasko-var">Kaskom Var</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="kasko-yok" name="kasko" value="yok">
                            <label for="kasko-yok">Kaskom Yok</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn-primary modal-submit">Talebi Gönder →</button>
            </form>
        </div>
    </div>
</body>

</html>