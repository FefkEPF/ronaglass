PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_USER=ronaglass_user
DB_PASSWORD=guclu_bir_sifre_kullanin
DB_NAME=ronaglass_db

# Zorunlu: rastgele uzun bir değer üretin, örn. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

ADMIN_USER=admin
# `node scripts/hash-password.js <şifreniz>` çıktısını buraya yapıştırın.
# ADMIN_PASSWORD_HASH tanımlıysa ADMIN_PASSWORD'a gerek yoktur.
ADMIN_PASSWORD_HASH=
