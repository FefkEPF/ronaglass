<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Giriş | Rona Auto Glass</title>
    <!-- Use basic Bootstrap 5 for admin UI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #050505; color: #fff; }
        .card { background-color: #111; border: 1px solid #333; }
        .form-control { background-color: #222; color: #fff; border: 1px solid #444; }
        .form-control:focus { background-color: #222; color: #fff; border-color: #d4af37; box-shadow: none; }
        .btn-primary { background-color: #d4af37; border: none; color: #000; }
        .btn-primary:hover { background-color: #aa8c2c; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center vh-100">
    <div class="card p-4 shadow-lg" style="width: 100%; max-width: 400px;">
        <div class="text-center mb-4">
            <img src="/images/logo.png" alt="Rona Logo" style="height: 60px;">
            <h4 class="mt-3 text-white">Yönetim Paneli</h4>
        </div>
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form action="/admin/login" method="POST">
            <div class="mb-3">
                <label class="form-label text-light">Kullanıcı Adı</label>
                <input type="text" name="username" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label text-light">Şifre</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold">Giriş Yap</button>
        </form>
    </div>
</body>
</html>
